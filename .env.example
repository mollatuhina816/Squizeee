# Copy to .env and supply unique values. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
ENVIRONMENT=development
API_PORT=8010
NEXT_PUBLIC_WS_ORIGIN=ws://localhost:8010
OPENAI_API_KEY=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_QUESTION_MODEL=gemini-2.5-flash-lite
OPENAI_QUESTION_MODEL=gpt-4.1-mini
AI_MAX_QUESTIONS_PER_REQUEST=20
AI_MAX_TEXT_LENGTH=20000
AI_MAX_IMAGE_SIZE_MB=10
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=8000
AI_DAILY_LIMIT_FACULTY=50
AI_DAILY_LIMIT_ADMIN=100
AI_DAILY_LIMIT_FACULTY_LITE=10
AI_REQUESTS_PER_MINUTE=5

# Optional trusted, sandboxed document services; leave blank to require manual legacy conversion.
# Conversion endpoint accepts multipart file + target=pdf and returns PDF bytes.
DOCUMENT_CONVERSION_URL=
# Rendering endpoint returns JSON images with section_number, mime_type and base64 data.
DOCUMENT_RENDERER_URL=
DOCUMENT_SERVICE_TOKEN=
IMPORT_AI_MAX_CONTEXT_CHARS=350000
